#Env
HOST="0.0.0.0"
PORT="5000"
DEVICE = cuda

# ========== STT 設定 (Speech-to-Text) ==========
STT_MODEL_SIZE = "large-v3"  # tiny, base, small, medium, large

# ========== TTS 設定 (Text-to-Speech) ==========
# TTS_ENGINE = coqui | vibevoice
TTS_ENGINE = vibevoice


TTS_MODEL = tts_models/multilingual/multi-dataset/xtts_v2
# TTS_SPEAKER_WAV = ./myvoice.wav

VIBEVOICE_VOICES_DIR = resources/voices/streaming_model
VIBEVOICE_VOICE=jp-Spk0_man.pt
VIBEVOICE_CFG_SCALE=1.5
VIBEVOICE_DDPM_STEPS=5

# ========== LLM 設定 (Language Model) ==========
LLM_MODEL = qwen3:8b # qwen3:30b-a3b
LLM_SYSTEM_PROMPT = "你是一個聊天助手，對於使用者的問題提供資訊和建議，每次的對話都盡可能的用簡短的句子做回覆，就像一般人在對話那樣。"
LLM_API_URL = http://127.0.0.1:11434/
LLM_TIMEOUT = 60  # seconds



# ========== 工具設定 ==========
ACCOUNT_TOOL_WEBHOOK = 

# ========== WebRTC/STUN/TURN 設定 ==========
# STUN 伺服器（可選，但建議保留）
RTC_STUN_URLS=

# TURN 伺服器（建議用 443 + TLS 的版本，穿透力最強）
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_PASSWORD=

# 強制只走 TURN（避開 ngrok 的 UDP 限制）
RTC_ICE_TRANSPORT_POLICY="relay"
